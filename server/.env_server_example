# Supabase (used by .NET for direct Postgres connection + admin-level access)
SUPABASE_DB_CONNECTION_STRING=Host=your-project.supabase.co;Database=postgres;Username=postgres;Password=your-db-password
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Weather API (used for the outfit suggestion endpoint)
OPENWEATHERMAP_API_KEY=your-openweathermap-key

# CORS: which frontend origin(s) are allowed to call this API
CLIENT_ORIGIN=http://localhost:5173